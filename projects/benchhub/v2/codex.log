@media(max-width:479px){main{padding:24px 16px 40px}.header-inner{padding-inline:16px}.brand{font-size:21px}.header-right{gap:8px}.cards{grid-template-columns:1fr}.bench-desc{min-height:0}.page-head{flex-direction:column;gap:16px}.catalog-toolbar{align-items:stretch;flex-direction:column}.search{max-width:none}.catalog-toolbar>.small{align-self:flex-end}.form-grid{grid-template-columns:1fr}.form-body,.output-body{padding:20px}.panel-title{padding:16px 20px}.run-table tbody{grid-template-columns:1fr}.results-toolbar{align-items:flex-start;flex-direction:column}.metric{padding:16px}.metric-grid{gap:12px}.task-list{padding-inline:16px}.task-list summary{gap:8px;flex-wrap:wrap;padding:12px 0}.task-list summary .task-title{flex-basis:70%}.task-content{padding-left:0}.view-footer,.catalog-footer{flex-direction:column;gap:8px}.terminal{padding:20px}.output-tabs{padding-inline:20px}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{transition:none!important;animation:none!important}}
</style></head><body>
<header><div class="header-inner"><div class="brand"><div class="brandmark"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 5v14h5c3 0 5-1.5 5-4s-2-3.5-5-3.5H5m5 0c3 0 4-1.5 4-3S13 5 10 5H5m14 1v12" stroke="currentColor" stroke-width="2"/></svg></div>BenchHub</div><nav aria-label="主导航"><button class="active" data-page="catalog">Bench 目录</button><button data-page="config">配置运行</button><button data-page="results">运行结果</button></nav><div class="header-right"><span class="example">示例工作空间</span><span class="avatar" aria-label="示例用户">BH</span></div></div></header>
<main>
<section id="catalog" class="view"><div class="page-head"><div><p class="eyebrow">BENCHMARKS</p><h1>找到下一场评测</h1><p>从代码到浏览器，为你的 Agent 选择合适的挑战。</p></div><button class="btn" id="recent-btn"><span class="icon-slot" data-icon="history"></span>查看运行记录</button></div><div class="catalog-layout"><aside class="filters" aria-label="目录筛选"><div class="filter-head"><strong class="small">筛选条件</strong><button class="text-btn" id="reset">重置</button></div><fieldset class="filter-group"><legend>评测类别</legend><div id="category-filters"></div></fieldset><fieldset class="filter-group"><legend>评分方式</legend><div id="scoring-filters"></div></fieldset><div class="filter-note">所有元数据均为示例<br>选择 Bench 后即可配置运行。<br>无需在平台安装 Agent。</div></aside><div><div class="catalog-toolbar"><label class="search"><span class="icon-slot" data-icon="search"></span><input id="search" aria-label="搜索 benchmark" placeholder="搜索 Benchmark 名称…" type="search"></label><span class="small muted" id="bench-count"></span></div><div class="cards" id="cards"></div><div class="catalog-footer"><span>所有 Benchmark 的版本、任务数与运行时间均为示例数据</span><span>基于 harbor 运行协议</span></div></div></div></section>
<section id="config" class="view" hidden><div class="page-head"><div><p class="eyebrow">RUN CONFIGURATION</p><h1>配置运行</h1><p>选择 Agent 和模型，把评测带到你的本地环境。</p></div><button class="btn" id="change-bench"><span class="icon-slot" data-icon="grid"></span>更换 Bench</button></div><div class="config-grid"><div class="panel"><div class="panel-title"><div class="od-field"><h2 id="config-bench">AACR-Bench</h2><small class="muted" id="config-version"></small></div><span class="tag blue" id="config-category">代码审查</span></div><form id="config-form" class="form-body"><div class="form-grid"><div class="field"><label for="agent">被测 Agent</label><select id="agent"><option value="codex">Codex</option><option value="claude-code">Claude Code</option><option value="cursor-cli">Cursor CLI</option><option value="opencode">OpenCode</option><option value="pi">Pi</option><option value="gemini-cli">Gemini CLI</option></select></div><div class="field"><label for="model">被测模型</label><select id="model"></select></div></div><div class="form-section"><div class="field-label" id="sample-label">任务范围</div><div class="segmented" role="group" aria-labelledby="sample-label"><button type="button" class="selected" data-sample="all" aria-pressed="true">全部任务</button><button type="button" data-sample="50" aria-pressed="false">抽样 50</button></div><p class="small muted" id="sample-help" style="margin-top:8px"></p><div class="form-grid" style="margin-top:20px"><div class="field"><label for="repeat">每题运行次数 k</label><input id="repeat" type="number" min="1" max="20" value="1" required aria-describedby="repeat-help"><small id="repeat-help">1–20 次，用于多次采样评估</small></div><div class="field"><label for="concurrency">并发数</label><input id="concurrency" type="number" min="1" max="32" value="4" required aria-describedby="concurrency-help"><small id="concurrency-help">1–32，根据本地资源设置</small></div></div></div><div class="form-section"><h3>评分参数 <span class="tag">示例配置</span></h3><div class="form-grid"><div class="field"><label for="tolerance">行号容差 k</label><input id="tolerance" type="number" min="0" max="10" value="1" required aria-describedby="tolerance-help"><small id="tolerance-help">0–10 行；与运行次数 k 独立</small></div><div class="field"><label for="judge">裁判模型</label><select id="judge"><option>gpt-5</option><option>claude-sonnet-4</option><option>gemini-2.5-pro</option></select><small>用于匹配评论与评估审查质量</small></div></div></div><div class="note"><span class="icon-slot" data-icon="info"></span><span>运行在你的本地环境。API 密钥不会写入命令或 Skill。</span></div></form></div><div><div class="panel"><div class="output-tabs" role="tablist" aria-label="运行方式"><button role="tab" aria-selected="true" aria-controls="command-pane" id="command-tab" class="selected" data-output="command"><span class="icon-slot" data-icon="terminal"></span>命令</button><button role="tab" aria-selected="false" aria-controls="skill-pane" id="skill-tab" data-output="skill"><span class="icon-slot" data-icon="file"></span>Skill</button><span class="tag" style="margin-left:auto">实时生成</span></div><div class="output-body"><div id="command-pane" role="tabpanel" aria-labelledby="command-tab"><div class="output-label"><span class="small muted">在本地终端运行</span><button class="btn" id="copy"><span class="icon-slot" data-icon="copy"></span>复制命令</button></div><div class="terminal"><div class="terminal-top"><i></i><i></i><i></i><span>Terminal</span></div><pre><span class="prompt">$ </span><code id="command"></code></pre></div><div class="output-info"><div class="info-row"><span class="icon-slot" data-icon="settings"></span><div><strong>当前运行配置</strong><p id="config-summary"></p></div></div><div class="info-row"><span class="icon-slot" data-icon="file"></span><div><strong>额外评分与采样设置</strong><p id="extra-summary"></p><p style="margin-top:8px">命令沿用给定示例。额外参数记录在 Skill 中，运行前需按实际 Harbor 版本配置。</p></div></div></div></div><div id="skill-pane" role="tabpanel" aria-labelledby="skill-tab" hidden><div class="output-label"><span class="mono small">SKILL.md</span><button class="btn" id="download"><span class="icon-slot" data-icon="download"></span>下载 Skill</button></div><pre id="skill" class="skill-pre" tabindex="0"></pre></div><div class="note"><span class="icon-slot" data-icon="upload"></span><div><strong style="display:block;margin-bottom:4px">本地运行后结果会自动回传</strong><span>正式接入需配置上传服务与凭据。本原型使用示例结果，不实际执行或上传。</span></div></div></div></div><div class="view-footer"><span>配置与生成内容均为演示用途</span><button class="text-btn" id="config-results">查看示例运行结果 →</button></div></div></div></section>
<section id="results" class="view" hidden><div id="run-overview"><div class="page-head"><div><p class="eyebrow">EVALUATION RUNS</p><h1>运行结果</h1><p>每一次运行，都让 Agent 的能力更清晰。</p></div><button class="btn btn-primary" id="new-run"><span class="icon-slot" data-icon="plus"></span>配置新运行</button></div><div class="panel"><div class="results-toolbar"><div class="od-row"><strong class="small">运行记录</strong><span class="tag">示例数据</span></div><label class="od-row small muted">状态<select id="run-status" aria-label="筛选运行状态"><option value="all">全部状态</option><option value="done">完成</option><option value="running">运行中</option><option value="failed">失败</option></select></label></div><table class="run-table"><thead><tr><th>Benchmark / 运行 ID</th><th>Agent</th><th>模型</th><th>状态</th><th>评测指标</th><th>耗时</th><th>Token</th><th></th></tr></thead><tbody id="runs"></tbody></table><div class="table-footer" id="run-count"></div></div><div class="view-footer"><span>示例运行记录 · 无真实本地进程连接</span><span>点击 Benchmark 查看逐任务结果</span></div></div><div id="run-detail" hidden></div></section>
</main><div class="toast" role="status" id="toast" hidden></div>
<script>
const paths={search:'M21 21l-5-5M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0',grid:'M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z',arrow:'M5 12h14m-6-6 6 6-6 6',code:'m8 6-6 6 6 6m8-12 6 6-6 6m-3-15-2 18',terminal:'m5 7 5 5-5 5m8 0h6M3 3h18v18H3z',searchbench:'M10 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16m6-2 6 6',review:'M5 3h14v18H5zM8 7h8m-8 4h8m-8 4h4',chat:'M3 3h18v14H8l-5 4V3m4 5h10m-10 4h6',file:'M5 3h9l5 5v13H5zM14 3v6h5M8 13h8m-8 4h6',copy:'M9 9h12v12H9zM15 9V3H3v12h6',download:'M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5',upload:'M12 16V3m-5 5 5-5 5 5M4 16v5h16v-5',info:'M12 11v6m0-10v1M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0',settings:'M4 7h16M4 17h16M8 4v6m8 4v6',check:'m5 12 4 4L19 6',clock:'M12 6v6l4 2M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0',x:'m6 6 12 12M6 18 18 6',history:'M3 10a9 9 0 1 1 2 8M3 3v7h7m2-4v6l4 2',plus:'M12 5v14M5 12h14',back:'M19 12H5m6-6-6 6 6 6',chevron:'m9 5 7 7-7 7'};
function icon(n,cls=''){return `<svg class="od-icon ${cls}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${paths[n]||paths.code}"/></svg>`}document.querySelectorAll('[data-icon]').forEach(e=>e.innerHTML=icon(e.dataset.icon));
const benches=[{name:'SWE-bench Verified',slug:'swe-bench-verified',version:'1.0',category:'编码',score:'执行测试',tasks:500,last:'10 月 11 日 · 09:42',desc:'真实 GitHub 问题，检验端到端代码修复能力。',icon:'code'},{name:'Terminal-Bench 2.0',slug:'terminal-bench',version:'2.0',category:'编码',score:'执行测试',tasks:89,last:'10 月 10 日 · 16:30',desc:'在真实终端环境中完成复杂、多步骤任务。',icon:'terminal'},{name:'AACR-Bench',slug:'aacr-bench',version:'1.0',category:'代码审查',score:'评论匹配',tasks:200,last:'10 月 11 日 · 11:08',desc:'理解代码变更，发现问题并给出准确审查评论。',icon:'review'},{name:'SWE-Together',slug:'swe-together',version:'1.0',category:'多轮交互',score:'模拟用户',tasks:120,last:'10 月 09 日 · 14:15',desc:'与模拟用户协作，逐步澄清需求并完成开发。',icon:'chat'},{name:'BrowseComp',slug:'browsecomp',version:'1.0',category:'搜索',score:'LLM 裁判',tasks:1266,last:'10 月 10 日 · 10:24',desc:'从开放网络中检索、推理并找到难寻的答案。',icon:'searchbench'},{name:'GAIA',slug:'gaia',version:'1.0',category:'多轮交互',score:'LLM 裁判',tasks:466,last:'尚未运行',desc:'结合工具使用与多步推理，解决通用助理任务。',icon:'grid'}];
const cats=['编码','代码审查','搜索','多轮交互'],scores=['执行测试','评论匹配','LLM 裁判','模拟用户'];[['category-filters',cats,'category'],['scoring-filters',scores,'score']].forEach(([id,list,key])=>document.getElementById(id).innerHTML=list.map(v=>`<label class="check"><input type="checkbox" value="${v}" data-filter="${key}"><span>${v}</span><span class="count">${benches.filter(b=>b[key]===v).length}</span></label>`).join(''));
let selectedBench=benches[2],sample='all',output='command',currentPage='catalog',catalogScroll=0,skillText='',commandText='',valid=true;const $=id=>document.getElementById(id);const escape=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function showPage(page){if(currentPage==='catalog')catalogScroll=window.scrollY;currentPage=page;document.querySelectorAll('.view').forEach(e=>e.hidden=e.id!==page);document.querySelectorAll('[data-page]').forEach(e=>{e.classList.toggle('active',e.dataset.page===page);if(e.dataset.page===page)e.setAttribute('aria-current','page');else e.removeAttribute('aria-current')});if(page==='results'){$('run-overview').hidden=false;$('run-detail').hidden=true}window.scrollTo(0,page==='catalog'?catalogScroll:0)}document.querySelectorAll('[data-page]').forEach(e=>e.onclick=()=>showPage(e.dataset.page));
function renderCatalog(){const query=$('search').value.toLowerCase().trim(),get=k=>[...document.querySelectorAll(`[data-filter="${k}"]:checked`)].map(e=>e.value),c=get('category'),s=get('score');const rows=benches.filter(b=>(!query||b.name.toLowerCase().includes(query))&&(!c.length||c.includes(b.category))&&(!s.length||s.includes(b.score)));$('bench-count').textContent=`${rows.length} 个 Benchmark`;$('cards').innerHTML=rows.length?rows.map(b=>`<article class="bench-card"><div class="card-top"><div class="bench-glyph">${icon(b.icon)}</div><span class="version">v${b.version}</span></div><h3>${b.name}</h3><div><span class="tag ${b.category==='代码审查'?'blue':''}">${b.category}</span></div><p class="bench-desc">${b.desc}</p><div class="bench-stats"><div class="od-stat"><small>任务数</small><strong class="mono">${b.tasks.toLocaleString()} <span class="small muted">项</span></strong></div><div class="od-stat"><small>评分方式</small><strong>${b.score}</strong></div></div><div class="card-bottom"><div class="od-field"><small>最近运行</small><small>${b.last}</small></div><button class="card-link" data-bench="${b.slug}" aria-label="配置 ${b.name}">配置运行 ${icon('arrow')}</button></div></article>`).join(''):'<div class="empty"><h3>没有匹配的 Benchmark</h3><p>尝试其他名称，或清除筛选条件。</p><button class="btn" onclick="resetFilters()">清除筛选</button></div>';document.querySelectorAll('[data-bench]').forEach(e=>e.onclick=()=>{selectedBench=benches.find(b=>b.slug===e.dataset.bench);updateConfig();showPage('config')})}
function resetFilters(){$('search').value='';document.querySelectorAll('[data-filter]').forEach(e=>e.checked=false);renderCatalog()}$('reset').onclick=resetFilters;$('search').oninput=renderCatalog;document.querySelectorAll('[data-filter]').forEach(e=>e.onchange=renderCatalog);
const models={'codex':['gpt-5','gpt-5-mini'],'claude-code':['claude-sonnet-4','claude-opus-4'],'cursor-cli':['claude-sonnet-4','gpt-5'],'opencode':['gpt-5','claude-sonnet-4','gemini-2.5-pro'],'pi':['claude-sonnet-4','gpt-5'],'gemini-cli':['gemini-2.5-pro','gemini-2.5-flash']};function setModels(){$('model').innerHTML=models[$('agent').value].map(m=>`<option>${m}</option>`).join('')}
function checkNumber(id,show=true){const e=$(id),n=Number(e.value),ok=e.value!==''&&Number.isInteger(n)&&n>=Number(e.min)&&n<=Number(e.max);e.setAttribute('aria-invalid',String(!ok));const h=$(id+'-help');if(show){h.classList.toggle('error',!ok);h.textContent=!ok?`请输入 ${e.min}–${e.max} 之间的整数。`:id==='repeat'?'1–20 次，用于多次采样评估':id==='concurrency'?'1–32，根据本地资源设置':'0–10 行；与运行次数 k 独立'}return ok}
function updateConfig(){valid=['repeat','concurrency','tolerance'].every(id=>checkNumber(id,false));const b=selectedBench,a=$('agent').value,m=$('model').value,r=$('repeat').value,c=$('concurrency').value,t=$('tolerance').value,j=$('judge').value,n=sample==='all'?b.tasks:Math.min(50,b.tasks);$('config-bench').textContent=b.name;$('config-version').textContent=`v${b.version} · ${b.tasks} 项示例任务`;$('config-category').textContent=b.category;$('sample-help').textContent=`本次评测 ${n} 项任务 · ${sample==='all'?'完整任务集':'固定抽样，便于快速验证'}`;$('config-summary').textContent=`${n} 项任务 × ${r||'—'} 次运行 · 并发 ${c||'—'} · ${m}`;$('extra-summary').textContent=`任务范围：${sample==='all'?'全部':'抽样 50'}；每题运行 ${r||'—'} 次；行号容差 ${t||'—'}；裁判模型 ${j}。`;commandText=valid?`harbor run -d ${b.slug}@${b.version} -a ${a} -m ${m} --n-concurrent ${c} --upload`:'';$('command').textContent=valid?commandText:'请修正左侧数值参数后生成命令。';skillText=`---\nname: benchhub-evaluation\ndescription: ${b.name} 本地评测配置（示例）\n---\n\n# ${b.name} 运行 Skill\n\n## 目标\n使用 ${$('agent').selectedOptions[0].textContent} / ${m} 运行评测。\n\n## 运行配置（演示）\n- 数据集：${b.slug}@${b.version}\n- 任务范围：${sample==='all'?'全部': '抽样 50'}（${n} 项）\n- 每题运行次数 k：${r}\n- 并发数：${c}\n- 行号容差 k：${t}\n- 裁判模型：${j}\n\n## 执行前\n确认 Harbor、被测 Agent 及模型凭据已配置。\n确认数据集版本可用，并配置正式上传服务与凭据。\n以上采样、重复运行及评分设置需按实际 Harbor 版本映射，\n此示例不声明额外 CLI 参数的兼容性。\n\n## 基础命令\n\n\`\`\`sh\n${commandText||'# 请修正参数'}\n\`\`\`\n\n## 结果\n正式接入后，本地运行结果通过 --upload 自动回传。\n本原型不执行命令、不上传结果；界面中的结果均为示例。\n不得将 API 密钥写入本文件。\n`;$('skill').textContent=skillText;$('copy').disabled=!valid;$('download').disabled=!valid}
$('agent').onchange=()=>{setModels();updateConfig()};['model','judge'].forEach(id=>$(id).onchange=updateConfig);['repeat','concurrency','tolerance'].forEach(id=>{$(id).oninput=updateConfig;$(id).onblur=()=>{checkNumber(id);updateConfig()}});$('config-form').onsubmit=e=>e.preventDefault();document.querySelectorAll('[data-sample]').forEach(e=>e.onclick=()=>{sample=e.dataset.sample;document.querySelectorAll('[data-sample]').forEach(b=>{b.classList.toggle('selected',b===e);b.setAttribute('aria-pressed',String(b===e))});updateConfig()});
function switchOutput(v){output=v;document.querySelectorAll('[data-output]').forEach(e=>{e.classList.toggle('selected',e.dataset.output===v);e.setAttribute('aria-selected',String(e.dataset.output===v))});$('command-pane').hidden=v!=='command';$('skill-pane').hidden=v!=='skill'}document.querySelectorAll('[data-output]').forEach(e=>{e.onclick=()=>switchOutput(e.dataset.output);e.onkeydown=ev=>{if(['ArrowLeft','ArrowRight'].includes(ev.key)){ev.preventDefault();let v=output==='command'?'skill':'command';switchOutput(v);$(v+'-tab').focus()}}});
let toastTimer;function toast(msg){$('toast').textContent=msg;$('toast').hidden=false;clearTimeout(toastTimer);toastTimer=setTimeout(()=>$('toast').hidden=true,4000)}$('copy').onclick=async()=>{try{if(navigator.clipboard&&window.isSecureContext)await navigator.clipboard.writeText(commandText);else{const el=document.createElement('textarea');el.value=commandText;el.style.position='fixed';el.style.opacity='0';document.body.append(el);el.select();const ok=document.execCommand('copy');el.remove();if(!ok)throw Error()}toast('命令已复制，可以粘贴到本地终端')}catch{toast('浏览器未允许复制，请选择终端中的命令手动复制');const range=document.createRange();range.selectNodeContents($('command'));const sel=window.getSelection();sel.removeAllRanges();sel.addRange(range)}};$('download').onclick=()=>{const url=URL.createObjectURL(new Blob([skillText],{type:'text/markdown;charset=utf-8'})),a=document.createElement('a');a.href=url;a.download='SKILL.md';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);toast('SKILL.md 已下载')};
